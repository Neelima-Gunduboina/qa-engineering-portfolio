<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Reproduces the open defects in docs/defects/. These tests are EXPECTED to fail until
     the defects are fixed: mvn test -Pknown-defects -->
<suite name="Known Defects" parallel="none">
    <test name="Known Defects">
        <groups>
            <run>
                <include name="known-defect"/>
            </run>
        </groups>
        <classes>
            <class name="com.neelima.qa.tests.api.AccountApiTest"/>
        </classes>
    </test>
</suite>
