<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- UI suites run sequentially: the public ParaBank demo is shared and rate-limited, and has
     shown server-side state leaking across sessions (DEF-002), so parallel sessions can interfere. -->
<suite name="Full Suite" parallel="none">
    <test name="Full Suite">
        <groups>
            <run>
                <exclude name="known-defect"/>
            </run>
        </groups>
        <classes>
            <class name="com.neelima.qa.tests.ui.RegisterTest"/>
            <class name="com.neelima.qa.tests.ui.LoginTest"/>
            <class name="com.neelima.qa.tests.ui.FundTransferTest"/>
            <class name="com.neelima.qa.tests.ui.BillPayTest"/>
            <class name="com.neelima.qa.tests.api.AccountApiTest"/>
            <class name="com.neelima.qa.tests.db.TransactionDbTest"/>
        </classes>
    </test>
</suite>
