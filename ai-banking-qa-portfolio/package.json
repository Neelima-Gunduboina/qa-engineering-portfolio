{
  "name": "ai-banking-qa-portfolio",
  "version": "1.0.0",
  "description": "AI-powered Playwright test automation framework for banking — GenAI self-healing locators, LLM test generation, failure triage, and Playwright MCP integration.",
  "author": "Neelima Gunduboina",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:visual": "playwright test tests/visual",
    "test:a11y": "playwright test tests/a11y",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "generate-tests": "ts-node scripts/generate-tests.ts",
    "triage": "ts-node scripts/triage.ts",
    "update-snapshots": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@axe-core/playwright": "^4.10.0",
    "axe-core": "^4.10.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
